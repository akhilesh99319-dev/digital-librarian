# Digital Librarian — Environment Configuration Template
# Copy this file to .env for local development

# Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=*

# Authentication (Use a strong random secret in production)
JWT_SECRET=your_secure_random_jwt_secret_here
JWT_EXPIRES_IN=7d

# Library Fine Configuration (Rate in INR per overdue day)
FINE_RATE_PER_DAY=5

# Database Configuration
# For local SQLite (default if DATABASE_URL is unset):
DB_PATH=database/library.db

# For Production PostgreSQL (e.g. Render PostgreSQL):
# DATABASE_URL=postgresql://librarian:password@host:5432/library_management_system?sslmode=require
